{
  "name": "discordcameralive-gui",
  "private": true,
  "version": "1.1.5",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "compile": "node scripts/sync-bypass.mjs && tsc && vite build",
    "build": "npm run compile && electron-builder --publish never",
    "build:win": "npm run compile && electron-builder --win --x64 --publish never",
    "build:mac": "npm run compile && electron-builder --mac --arm64 --publish never",
    "preview": "vite preview",
    "sync-bypass": "node scripts/sync-bypass.mjs",
    "build:linux": "npm run compile && electron-builder --linux AppImage --publish never",
    "publish:win": "npm run compile && electron-builder --win --x64 --publish always",
    "publish:mac": "npm run compile && electron-builder --mac --arm64 --publish always",
    "publish:linux": "npm run compile && electron-builder --linux AppImage --publish always"
  },
  "build": {
    "appId": "com.discordcameralive.gui",
    "productName": "DiscordCameraLive",
    "copyright": "Baseado no GoLiveBypass, de bezumiya e colaboradores. Modificações do DiscordCameraLive: x7rG. GPL-3.0-or-later.",
    "publish": {
      "provider": "github",
      "owner": "xx7rG",
      "repo": "DiscordCameraLive",
      "releaseType": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "assets"
    ],
    "directories": {
      "output": "dist-app"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "../standalone",
        "to": "extra/standalone",
        "filter": [
          "discordcameralive-standalone.sh",
          "discordcameralive.js"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "category": "public.app-category.utilities",
      "artifactName": "${productName}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
